# # AlloyDB instance URI: projects/PROJECT_ID/locations/REGION/clusters/CLUSTER_ID/instances/INSTANCE_ID
# ALLOYDB_INSTANCE_URI=projects/navi-scheme/locations/asia-south1/clusters/navi-scheme2214/instances/navi-scheme2214-primary
# ALLOYDB_DATABASE=postgres
# ALLOYDB_USER=postgres
# ALLOYDB_PASSWORD=NaviScheme2214
# ALLOYDB_ENABLE_IAM_AUTH=false

# # IP Type: Set to PUBLIC if connecting from your local machine with public IP enabled on AlloyDB.
# # Set to PRIVATE if running within GCP VPC or over VPN.
# ALLOYDB_IP_TYPE=PUBLIC

# # GCP Service Account key file path (optional, if not using 'gcloud auth application-default login')
# # GOOGLE_APPLICATION_CREDENTIALS=service-account-key.json

# # Direct host fallback (optional, if using AlloyDB Auth Proxy locally)
# # ALLOYDB_HOST=127.0.0.1
# # ALLOYDB_PORT=5432