# ================================================================
# Navi Scheme Database Configuration
# ================================================================

# Option 1: Local SQLite (Recommended: 0 setup, 100% free, runs locally & offline)
DATABASE_URL=sqlite:///./navi_scheme.db

# Option 2: Local PostgreSQL (if running PostgreSQL locally or via Docker)
# DATABASE_URL=postgresql+pg8000://postgres:password@localhost:5432/navi_scheme

# Option 3: Free Cloud PostgreSQL for Production (e.g., Neon.tech, Supabase, Render free tier)
# DATABASE_URL=postgresql+pg8000://user:password@ep-sample-123.neon.tech/neondb?ssl=require

# Option 4: AlloyDB / Cloud SQL (Only if you have GCP credits)
# ALLOYDB_INSTANCE_URI=projects/PROJECT_ID/locations/REGION/clusters/CLUSTER_ID/instances/INSTANCE_ID
# ALLOYDB_DATABASE=postgres
# ALLOYDB_USER=postgres
# ALLOYDB_PASSWORD=your_password