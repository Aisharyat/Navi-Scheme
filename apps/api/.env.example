# ================================================================
# Navi Scheme Environment Configuration (SQLite Default)
# ================================================================

# --- Runtime ---
NODE_ENV=development
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi
RATE_LIMIT_RPM=60

# --- Database (SQLite - Local & Zero-Cost) ---
DB_DRIVER=sqlite
DATABASE_URL=sqlite:///./navi_scheme.db
SQLITE_PATH=./navi_scheme.db

# --- Optional Cloud Database (PostgreSQL / AlloyDB) ---
# DATABASE_URL=postgresql+pg8000://user:password@host:5432/dbname
# ALLOYDB_INSTANCE_URI=projects/PROJECT_ID/locations/REGION/clusters/CLUSTER_ID/instances/INSTANCE_ID
# ALLOYDB_DATABASE=postgres
# ALLOYDB_USER=postgres
# ALLOYDB_PASSWORD=your_password

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=8000

# --- Auth ---
JWT_SECRET_KEY=navi-scheme-jwt-secret-key-production-2026-secure-token
JWT_EXPIRES_IN=7d
ADMIN_BOOTSTRAP_EMAIL=admin@navischeme.gov.in
ADMIN_DEFAULT_PASSWORD=Admin@123